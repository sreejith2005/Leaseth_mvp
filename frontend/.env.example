# Leaseth Frontend Environment Variables
#
# HOW IT WORKS (automatic switching — no manual changes needed):
#   .env.development  → used by `npm run dev`   → http://localhost:8000
#   .env.production   → used by `npm run build`  → public HF Space URL
#
# To set up local dev, create .env.development with:
#   VITE_API_URL=http://localhost:8000
#
# Production (already committed in .env.production):
VITE_API_URL=https://sreejithm-leaseth-mvp.hf.space
